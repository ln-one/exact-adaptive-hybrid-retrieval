        <mxCell id="title" value="EAHR Bench: from public inputs to verifiable paper evidence" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Three boundaries keep third-party data, executable experiments, and public source data separate." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5B6B7A;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1120" height="30" as="geometry" />
